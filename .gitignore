# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
tmp/
.tmp/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
/lib/l10n/generated
/test/**/*.mocks.dart
/test/**/.snaptest/
/test/**/failures/

# Flutter desktop generated plugin registrants
/linux/flutter/generated_plugin_registrant.*
/linux/flutter/generated_plugins.cmake
/macos/Flutter/GeneratedPluginRegistrant.swift
/windows/flutter/generated_plugin_registrant.*
/windows/flutter/generated_plugins.cmake

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Librispeech model directory (dev-only, not shipped)
/assets/EnglishLibrispeechConformerFBank/
# Model helper files not needed by the Flutter app
/assets/**/bpe.model
/assets/**/config.yaml
/assets/**/seq_rnnlm.onnx
# Third-party VAD model; fetched at build time via scripts/download_vad_model.sh
/assets/silero_vad.onnx


# Application Launcher Icons
/android/app/src/main/res/
/ios/Runner/Assets.xcassets/AppIcon.appiconset/
/macos/Runner/Assets.xcassets/AppIcon.appiconset/
/windows/runner/resources/

# Local-only model packages and scratch assets (never committed; kept on-device)
/asrmodels/
/assets/Test/

# Python export tooling virtualenv
/scripts/export/.venv/
