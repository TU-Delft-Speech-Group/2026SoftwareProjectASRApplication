# Auto detect text files and perform LF normalization
*        text=auto eol=lf
# Always perform LF normalization on these files
*.dart   text
*.gradle text
*.html   text
*.java   text
*.kts    text
*.kt     text
*.json   text
*.md     text
*.py     text
*.sh     text
*.txt    text
*.xml    text
*.yaml   text
# Make sure that these Windows files always have CRLF line endings in checkout
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf
# Never perform LF normalization on these files
*.ico    binary
*.jar    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.zip    binary
*.gz     binary
assets/**/*.onnx filter=lfs diff=lfs merge=lfs -text
